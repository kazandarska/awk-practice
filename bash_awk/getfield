#!/bin/bash 
	
	# getfield - extract fields in any order
	# usage: ./getfield [field field field....] [file file file....]
	# based on field by Aho, Weinberger and Kerninghan from AWK Programming Language 
	# tool update after minor improvements: handling various file types and arguments

awk '
	BEGIN { FS = "[ ;\t]+"
		for (i = 1; ARGV[i] ~ /^[0-9]+$/; i++) {
		fld[++nf] = ARGV[i]
		ARGV[i] = ""
	}
	if (i >= ARGC)
		ARGV[ARGC++] = "-"
	}
	{ for (i = 1; i <= nf; i++)
		printf ("%s%s", $fld[i], i < nf ? " " : "\n")
	}
	' "$@" | column -t


